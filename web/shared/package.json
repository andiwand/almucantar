{
  "name": "@almucantar/web-shared",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "The code that the web apps share: the place, the base map, the place panel, the terrain, the moon, and the orientation",
  "license": "MPL-2.0",
  "exports": {
    "./*.css": "./src/*.css",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "test": "vitest run",
    "format": "prettier --write src test *.json",
    "format:check": "prettier --check src test *.json"
  },
  "dependencies": {
    "@almucantar/core": "file:../../core/build/emscripten-wasm-release/wasm/dist"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
